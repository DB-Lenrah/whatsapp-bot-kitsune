# Environment Configuration for DB-Lenrah WhatsApp Bot

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/dblenrah_bot

# Primary AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Fallback AI Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# WhatsApp LocalAuth / Session Settings
WWEBJS_AUTH_PATH=./baileys_auth

# Anti-Spam Burst Settings
BURST_MAX_MESSAGES=4
BURST_WINDOW_MS=2000

# Server & Logging Settings
WA_API_PORT=3300
LOG_LEVEL=info
